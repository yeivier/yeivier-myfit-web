datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../../src/lib/zodSchemas"
}

/// Site-wide configuration, kept in a single row (id = "default").
/// `sessionSecret` signs the JWT session, generated on first boot so the app
/// works without a dashboard-managed AUTH_SECRET environment variable.
model AppAuth {
  id            String   @id @default("default")
  sessionSecret String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  COACH
  ATHLETE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model User {
  id             String          @id @default(cuid()) /// @zod.string.cuid2()
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  exerciseSplits ExerciseSplit[]
  mesocycles     Mesocycle[]
  workouts       Workout[]
  migratedFromV2 Boolean?
  settings       UserSettings?

  role         Role    @default(ATHLETE)
  passwordHash String?
  passwordSalt String?

  coach       User?         @relation("CoachAthletes", fields: [coachId], references: [id], onDelete: SetNull)
  coachId     String?
  athletes    User[]        @relation("CoachAthletes")
  invitesSent CoachInvite[] @relation("InvitesByCoach")
}

/// Lets a coach invite someone by email who doesn't have an account yet;
/// accepting the invite creates their ATHLETE account already linked to
/// that coach.
model CoachInvite {
  id        String       @id @default(cuid()) /// @zod.string.cuid2()
  coach     User         @relation("InvitesByCoach", fields: [coachId], references: [id], onDelete: Cascade)
  coachId   String
  email     String
  token     String       @unique
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  expiresAt DateTime
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  motivationalQuotesEnabled Boolean             @default(false)
  quotesDisplayModes        QuotesDisplayMode[] @default([PRE_WORKOUT])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
